    </button>

  </div>

</section>

<!-- =====================================================
     FLOATING CART
===================================================== -->

<button
  class="cart-floating"
  id="cartFloating"
  type="button"
  aria-label="Open shopping cart"
>

  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 1.9-1.5L21 8H7"></path>
    <circle cx="10" cy="20" r="1.5"></circle>
    <circle cx="18" cy="20" r="1.5"></circle>
  </svg>

  <span
    class="cart-count"
    id="cartCount"
  >
    0
  </span>

</button>

<!-- =====================================================
     LIST PANEL
===================================================== -->

<div
  class="panel"
  id="listPanel"
>

  <div class="panel-header">

    <h2>Selected Products</h2>

    <button
      class="panel-close"
      data-close-panel="listPanel"
      type="button"
    >
      ×
    </button>

  </div>

  <div id="selectedProducts"></div>

  <div class="cart-summary">

    <div class="summary-row">
      <span>Informational Total</span>
      <strong id="listTotal">$0.00</strong>
    </div>

    <button
      class="primary-btn"
      id="openCartFromList"
      type="button"
    >
      GO TO CART
    </button>

  </div>

</div>

<!-- =====================================================
     CART PANEL
===================================================== -->

<div
  class="panel"
  id="cartPanel"
>

  <div class="panel-header">

    <h2>Your Cart</h2>

    <button
      class="panel-close"
      data-close-panel="cartPanel"
      type="button"
    >
      ×
    </button>

  </div>

  <div id="cartItems"></div>

  <div class="option-box">

    <h3>Shipping</h3>

    <label class="option-label">

      <input
        type="radio"
        name="shipping"
        value="standard"
      >

      Standard — $9

    </label>

    <label class="option-label">

      <input
        type="radio"
        name="shipping"
        value="express"
      >

      Express — $15

    </label>

    <label class="option-label">

      <input
        type="radio"
        name="shipping"
        value="free"
      >

      Free Shipping — $200+

    </label>

  </div>

  <div class="option-box">

    <h3>Payment Method</h3>

    <label class="option-label">

      <input
        type="radio"
        name="payment"
        value="zelle"
      >

      Zelle

    </label>

    <label class="option-label">

      <input
        type="radio"
        name="payment"
        value="venmo"
      >

      Venmo

    </label>

    <label class="option-label">

      <input
        type="radio"
        name="payment"
        value="paypal"
      >

      PayPal

    </label>

  </div>

  <div class="cart-summary">

    <div class="summary-row">
      <span>Subtotal</span>
      <strong id="subtotal">$0.00</strong>
    </div>

    <div class="summary-row">
      <span>Shipping</span>
      <strong id="shippingCost">$0.00</strong>
    </div>

    <div class="summary-row total">
      <span>Total</span>
      <strong id="grandTotal">$0.00</strong>
    </div>

  </div>

  <button
    class="primary-btn"
    id="checkoutBtn"
    type="button"
  >
    CONTINUE
  </button>

  <button
    class="secondary-btn"
    id="clearCartBtn"
    type="button"
  >
    CLEAR CART
  </button>

  <p class="notice">
    This list is informational only. No payment is processed here.
  </p>

</div>

<!-- =====================================================
     INFORMATION PANEL
===================================================== -->

<div
  class="panel"
  id="informationPanel"
>

  <div class="panel-header">

    <h2>Information Request</h2>

    <button
      class="panel-close"
      data-close-panel="informationPanel"
      type="button"
    >
      ×
    </button>

  </div>

  <div id="formArea">

    <div class="reference-box">

      <div>
        Order / Reference Code
      </div>

      <div
        class="reference-code"
        id="referenceDisplay"
      >
        ----
      </div>

    </div>

    <form
      id="informationForm"
      action="https://formspree.io/f/myezrady"
      method="POST"
    >

      <input
        type="hidden"
        name="subject"
        value="NovaPeps USA Information Request"
      >

      <input
        type="hidden"
        name="reference_code"
        id="formReference"
      >

      <input
        type="hidden"
        name="selected_products"
        id="formProducts"
      >

      <input
        type="hidden"
        name="subtotal"
        id="formSubtotal"
      >

      <input
        type="hidden"
        name="shipping_method"
        id="formShipping"
      >

      <input
        type="hidden"
        name="shipping_cost"
        id="formShippingCost"
      >

      <input
        type="hidden"
        name="informational_total"
        id="formTotal"
      >

      <input
        type="hidden"
        name="payment_method"
        id="formPayment"
      >

      <input
        type="hidden"
        name="informational_notice"
        value="This information request does not process payment."
      >

      <div class="form-group">

        <label>Name</label>

        <input
          type="text"
          name="name"
          required
        >

      </div>

      <div class="form-group">

        <label>Email</label>

        <input
          type="email"
          name="email"
          required
        >

      </div>

      <div class="form-group">

        <label>Phone</label>

        <input
          type="tel"
          name="phone"
          required
        >

      </div>

      <div class="form-group">

        <label>Address</label>

        <input
          type="text"
          name="address"
          required
        >

      </div>

      <div class="form-group">

        <label>Apt / Unit</label>

        <input
          type="text"
          name="apt_unit"
        >

      </div>

      <div class="form-group">

        <label>City</label>

        <input
          type="text"
          name="city"
          required
        >

      </div>

      <div class="form-group">

        <label>State</label>

        <input
          type="text"
          name="state"
          required
        >

      </div>

      <div class="form-group">

        <label>ZIP</label>

        <input
          type="text"
          name="zip"
          required
        >

      </div>

      <div class="form-group">

        <label>Message</label>

        <textarea name="message"></textarea>

      </div>

      <button
        class="primary-btn"
        type="submit"
      >
        SEND INFORMATION
      </button>

    </form>

  </div>

  <div
    id="finalConfirmation"
    class="thank-you"
    style="display:none;"
  >

    <h2>THANK YOU!</h2>

    <p>
      Your information has been submitted.
    </p>

    <div
      class="payment-final"
      id="paymentFinal"
    ></div>

  </div>

</div>

<!-- =====================================================
     PRODUCT MODAL
===================================================== -->

<div
  class="modal"
  id="productModal"
>

  <div class="modal-content">

    <button
      class="modal-close"
      id="modalClose"
      type="button"
    >
      ×
    </button>

    <img
      class="modal-image"
      id="modalImage"
      src=""
      alt=""
    >

    <h2 id="modalName"></h2>

    <div
      class="modal-price"
      id="modalPrice"
    ></div>

    <div class="research">
      FOR RESEARCH USE ONLY
    </div>

    <div class="qty-controls">

      <button
        id="modalMinus"
        type="button"
      >
        −
      </button>

      <strong id="modalQuantity">
        1
      </strong>

      <button
        id="modalPlus"
        type="button"
      >
        +
      </button>

    </div>

    <button
      class="primary-btn"
      id="modalAdd"
      type="button"
    >
      ADD TO CART
    </button>

    <button
      class="secondary-btn"
      id="modalGoCart"
      type="button"
    >
      GO TO CART / CHECKOUT
    </button>

  </div>

</div>

<!-- =====================================================
     FOOTER
===================================================== -->

<footer>

  <p>
    © 2026 NovaPeps USA
  </p>

  <p>
    novapeps22@gmail.com
  </p>

  <p>
    (832) 273-9625
  </p>

  <p
    class="notice"
    style="color:#aaa;"
  >
    All products are presented for research use only.
  </p>

</footer>

<script>

/* =====================================================
   PRODUCTS
===================================================== */

const PRODUCTS = [

  {
    name:"MOTS-C 10 MG",
    price:60,
    image:"./55A6F8D2-C2C2-4582-BFB3-B93DACC10C28.png"
  },

  {
    name:"GLP-2 10 MG",
    price:90,
    image:"./5B460B8F-14FC-4B9A-9D17-339565C8ED0B.png"
  },

  {
    name:"GHK-CU 100 MG",
    price:50,
    image:"./6747079A-BB69-4F51-A792-565688C6BC86.png"
  },

  {
    name:"GLP-3 10 MG",
    price:95,
    image:"./713BA234-721B-4580-94DF-6677375C7826.png"
  },

  {
    name:"GLP-2 20 MG",
    price:110,
    image:"./7855AC8E-4FC3-47C9-B16B-B62AD1C36BF0.png"
  },

  {
    name:"GLP-3 20 MG",
    price:135,
    image:"./96BEC651-AA03-4D8D-9254-3FB8C8E85104.png"
  },

  {
    name:"GLUTATHIONE 1500 MG",
    price:60,
    image:"./A6F31BD7-FD7A-4EBD-B2F8-080DF7896871.png"
  },

  {
    name:"NAD+ 500 MG",
    price:50,
    image:"./EB389E57-904B-4E57-953C-407C50FA216A.png"
  }

];

const STORAGE = {

  selected:"novaSelectedProducts",

  favorites:"novaFavoriteProducts",

  shipping:"novaShippingOption",

  payment:"novaPaymentOption",

  lastOrder:"novaLastOrder",

  age:"novaAgeConfirmed"

};

let selectedProducts = [];

let favorites = [];

let modalProduct = null;

let modalQuantity = 1;

/* =====================================================
   STORAGE
===================================================== */

function getStorage(key,fallback){

  try{

    const value =
      localStorage.getItem(key);

    if(value === null){
      return fallback;
    }

    return JSON.parse(value);

  }catch(error){

    return fallback;

  }

}

function setStorage(key,value){

  try{

    localStorage.setItem(
      key,
      JSON.stringify(value)
    );

  }catch(error){}

}

/* =====================================================
   AGE
===================================================== */

function enterSite(){

  try{

    localStorage.setItem(
      STORAGE.age,
      "true"
    );

  }catch(error){}

  const gate =
    document.getElementById("ageGate");

  if(gate){
    gate.classList.add("hidden");
  }

  document.body.classList.remove("locked");

}

function leaveSite(){

  try{

    localStorage.removeItem(
      STORAGE.age
    );

  }catch(error){}

  document.body.innerHTML = `
    <div
      style="
        height:100vh;
        display:flex;
        align-items:center;
        justify-content:center;
        text-align:center;
        font-family:Arial;
        padding:30px;
      "
    >
      <div>
        <h1>Thank you.</h1>
        <p>You have chosen to exit this website.</p>
      </div>
    </div>
  `;

}

function initializeAgeGate(){

  const gate =
    document.getElementById("ageGate");

  const enter =
    document.getElementById("ageEnterBtn");

  const exit =
    document.getElementById("ageExitBtn");

  let confirmed = false;

  try{

    confirmed =
      localStorage.getItem(
        STORAGE.age
      ) === "true";

  }catch(error){}

  if(confirmed){

    gate.classList.add("hidden");

    document.body.classList.remove(
      "locked"
    );

  }else{

    gate.classList.remove("hidden");

    document.body.classList.add(
      "locked"
    );

  }

  enter.addEventListener(
    "click",
    function(event){

      event.preventDefault();

      enterSite();

    }
  );

  exit.addEventListener(
    "click",
    function(event){

      event.preventDefault();

      leaveSite();

    }
  );

}

/* =====================================================
   MENU
===================================================== */

function openMenu(){

  document
    .getElementById("sideMenu")
    .classList.add("open");

  document
    .getElementById("overlay")
    .classList.add("show");

}

function closeMenu(){

  document
    .getElementById("sideMenu")
    .classList.remove("open");

}

document
  .getElementById("menuBtn")
  .addEventListener(
    "click",
    openMenu
  );

document
  .getElementById("sideClose")
  .addEventListener(
    "click",
    closeMenu
  );

/* =====================================================
   PANELS
===================================================== */

function openPanel(id){

  closeMenu();

  document
    .getElementById(id)
    .classList.add("open");

  document
    .getElementById("overlay")
    .classList.add("show");

  if(id === "listPanel"){
    renderSelectedProducts();
  }

  if(id === "cartPanel"){
    renderCart();
  }

}

function closePanel(id){

  document
    .getElementById(id)
    .classList.remove("open");

  const anyPanel =
    document.querySelector(
      ".panel.open"
    );

  if(
    !anyPanel &&
    !document
      .getElementById("sideMenu")
      .classList
      .contains("open")
  ){

    document
      .getElementById("overlay")
      .classList.remove("show");

  }

}

function closeAllPanels(){

  document
    .querySelectorAll(".panel.open")
    .forEach(
      panel =>
        panel.classList.remove("open")
    );

  document
    .getElementById("sideMenu")
    .classList.remove("open");

  document
    .getElementById("overlay")
    .classList.remove("show");

  closeProductModal();

}

document
  .getElementById("overlay")
  .addEventListener(
    "click",
    closeAllPanels
  );

document
  .querySelectorAll("[data-open-panel]")
  .forEach(button => {

    button.addEventListener(
      "click",
      function(){

        openPanel(
          this.dataset.openPanel
        );

      }
    );

  });

document
  .querySelectorAll("[data-close-panel]")
  .forEach(button => {

    button.addEventListener(
      "click",
      function(){

        closePanel(
          this.dataset.closePanel
        );

      }
    );

  });

/* =====================================================
   HEADER SEARCH
===================================================== */

document
  .getElementById("headerSearchBtn")
  .addEventListener(
    "click",
    function(){

      openMenu();

      setTimeout(
        function(){

          const input =
            document.getElementById(
              "searchInput"
            );

          if(input){
            input.focus();
          }

        },
        250
      );

    }
  );

/* =====================================================
   HEADER CART
===================================================== */

document
  .getElementById("headerCartBtn")
  .addEventListener(
    "click",
    function(){

      openPanel("cartPanel");

    }
  );

/* =====================================================
   PRODUCT HELPERS
===================================================== */

function findProduct(name){

  return PRODUCTS.find(
    product =>
      product.name === name
  );

}

function normalize(text){

  return String(text)
    .toLowerCase()
    .normalize("NFD")
    .replace(
      /[\u0300-\u036f]/g,
      ""
    );

}

/* =====================================================
   SELECTED PRODUCTS
===================================================== */

function saveSelected(){

  setStorage(
    STORAGE.selected,
    selectedProducts
  );

}

function subtotal(){

  return selectedProducts.reduce(
    (total,item) =>
      total +
      item.price *
      item.quantity,
    0
  );

}

function addToList(
  product,
  quantity=1
){

  const existing =
    selectedProducts.find(
      item =>
        item.name === product.name
    );

  if(existing){

    existing.quantity += quantity;

  }else{

    selectedProducts.push({

      name:product.name,

      price:product.price,

      image:product.image,

      quantity:quantity

    });

  }

  saveSelected();

  updateCartCount();

  renderSelectedProducts();

  renderCart();

}

function changeQuantity(
  name,
  change
){

  const item =
    selectedProducts.find(
      product =>
        product.name === name
    );

  if(!item){
    return;
  }

  item.quantity += change;

  if(item.quantity <= 0){

    selectedProducts =
      selectedProducts.filter(
        product =>
          product.name !== name
      );

  }

  saveSelected();

  renderSelectedProducts();

  renderCart();

  updateCartCount();

}

function removeProduct(name){

  selectedProducts =
    selectedProducts.filter(
      item =>
        item.name !== name
    );

  saveSelected();

  renderSelectedProducts();

  renderCart();

  updateCartCount();

}

function clearCart(){

  selectedProducts = [];

  saveSelected();

  renderSelectedProducts();

  renderCart();

  updateCartCount();

}

/* =====================================================
   RENDER LIST
===================================================== */

function renderSelectedProducts(){

  const container =
    document.getElementById(
      "selectedProducts"
    );

  const total =
    document.getElementById(
      "listTotal"
    );

  if(
    selectedProducts.length === 0
  ){

    container.innerHTML =
      '<p class="notice">No products selected.</p>';

    total.textContent =
      "$0.00";

    return;

  }

  container.innerHTML =
    selectedProducts.map(
      item => `

        <div class="selected-item">

          <img
            src="${item.image}"
            alt="${escapeHtml(item.name)}"
          >

          <div class="selected-info">

            <strong>
              ${escapeHtml(item.name)}
            </strong>

            <div>
              $${item.price.toFixed(2)}
            </div>

            <div class="qty-controls">

              <button
                type="button"
                onclick="changeQuantity('${escapeJs(item.name)}',-1)"
              >
                −
              </button>

              <strong>
                ${item.quantity}
              </strong>

              <button
                type="button"
                onclick="changeQuantity('${escapeJs(item.name)}',1)"
              >
                +
              </button>

              <button
                class="remove-btn"
                type="button"
                onclick="removeProduct('${escapeJs(item.name)}')"
              >
                Remove
              </button>

            </div>

          </div>

        </div>

      `
    ).join("");

  total.textContent =
    "$" + subtotal().toFixed(2);

}

/* =====================================================
   CART COUNT
===================================================== */

function updateCartCount(){

  const count =
    selectedProducts.reduce(
      (sum,item) =>
        sum + item.quantity,
      0
    );

  document.getElementById(
    "cartCount"
  ).textContent = count;

  const headerCount =
    document.getElementById(
      "headerCartCount"
    );

  if(headerCount){

    headerCount.textContent =
      count;

  }

}

/* =====================================================
   SHIPPING
===================================================== */

function getShippingCost(){

  const selected =
    document.querySelector(
      'input[name="shipping"]:checked'
    );

  if(!selected){
    return 0;
  }

  if(
    selected.value ===
    "standard"
  ){
    return 9;
  }

  if(
    selected.value ===
    "express"
  ){
    return 15;
  }

  if(
    selected.value ===
    "free"
  ){

    return subtotal() >= 200
      ? 0
      : 9;

  }

  return 0;

}

function getShippingName(){

  const selected =
    document.querySelector(
      'input[name="shipping"]:checked'
    );

  if(!selected){
    return "";
  }

  if(
    selected.value ===
    "standard"
  ){
    return "Standard";
  }

  if(
    selected.value ===
    "express"
  ){
    return "Express";
  }

  if(
    selected.value ===
    "free"
  ){
    return "Free Shipping";
  }

  return "";

}

function getPayment(){

  const selected =
    document.querySelector(
      'input[name="payment"]:checked'
    );

  return selected
    ? selected.value
    : "";

}

/* =====================================================
   CART RENDER
===================================================== */

function renderCart(){

  const container =
    document.getElementById(
      "cartItems"
    );

  if(
    selectedProducts.length === 0
  ){

    container.innerHTML =
      '<p class="notice">Your cart is empty.</p>';

  }else{

    container.innerHTML =
      selectedProducts.map(
        item => `

          <div class="selected-item">

            <img
              src="${item.image}"
              alt="${escapeHtml(item.name)}"
            >

            <div class="selected-info">

              <strong>
                ${escapeHtml(item.name)}
              </strong>

              <div>
                $${item.price.toFixed(2)}
              </div>

              <div class="qty-controls">

                <button
                  type="button"
                  onclick="changeQuantity('${escapeJs(item.name)}',-1)"
                >
                  −
                </button>

                <strong>
                  ${item.quantity}
                </strong>

                <button
                  type="button"
                  onclick="changeQuantity('${escapeJs(item.name)}',1)"
                >
                  +
                </button>

                <button
                  class="remove-btn"
                  type="button"
                  onclick="removeProduct('${escapeJs(item.name)}')"
                >
                  Remove
                </button>

              </div>

            </div>

          </div>

        `
      ).join("");

  }

  updateTotals();

}

/* =====================================================
   TOTALS
===================================================== */

function updateTotals(){

  const sub =
    subtotal();

  const shipping =
    getShippingCost();

  const total =
    sub + shipping;

  document.getElementById(
    "subtotal"
  ).textContent =
    "$" + sub.toFixed(2);

  document.getElementById(
    "shippingCost"
  ).textContent =
    "$" + shipping.toFixed(2);

  document.getElementById(
    "grandTotal"
  ).textContent =
    "$" + total.toFixed(2);

  updateFormHiddenFields();

}

/* =====================================================
   RESTORE OPTIONS
===================================================== */

function restoreOptions(){

  const shipping =
    getStorage(
      STORAGE.shipping,
      null
    );

  const payment =
    getStorage(
      STORAGE.payment,
      null
    );

  if(shipping){

    const input =
      document.querySelector(
        `input[name="shipping"][value="${shipping}"]`
      );

    if(input){
      input.checked = true;
    }

  }

  if(payment){

    const input =
      document.querySelector(
        `input[name="payment"][value="${payment}"]`
      );

    if(input){
      input.checked = true;
    }

  }

}

document
  .querySelectorAll(
    'input[name="shipping"]'
  )
  .forEach(input => {

    input.addEventListener(
      "change",
      function(){

        setStorage(
          STORAGE.shipping,
          this.value
        );

        updateTotals();

      }
    );

  });

document
  .querySelectorAll(
    'input[name="payment"]'
  )
  .forEach(input => {

    input.addEventListener(
      "change",
      function(){

        setStorage(
          STORAGE.payment,
          this.value
        );

        updateFormHiddenFields();

      }
    );

  });

/* =====================================================
   CART BUTTONS
===================================================== */

document
  .getElementById("cartFloating")
  .addEventListener(
    "click",
    function(){

      openPanel(
        "cartPanel"
      );

    }
  );

document
  .getElementById("openCartFromList")
  .addEventListener(
    "click",
    function(){

      closePanel(
        "listPanel"
      );

      openPanel(
        "cartPanel"
      );

    }
  );

document
  .getElementById("clearCartBtn")
  .addEventListener(
    "click",
    function(){

      clearCart();

    }
  );

/* =====================================================
   CHECKOUT
===================================================== */

document
  .getElementById("checkoutBtn")
  .addEventListener(
    "click",
    function(){

      if(
        selectedProducts.length === 0
      ){

        alert(
          "Please select at least one product."
        );

        return;

      }

      const shipping =
        document.querySelector(
          'input[name="shipping"]:checked'
        );

      if(!shipping){

        alert(
          "Please select a shipping option."
        );

        return;

      }

      if(
        shipping.value === "free" &&
        subtotal() < 200
      ){

        alert(
          "Free Shipping is available only for orders of $200 or more."
        );

        return;

      }

      const payment =
        document.querySelector(
          'input[name="payment"]:checked'
        );

      if(!payment){

        alert(
          "Please select a payment method."
        );

        return;

      }

      prepareInformationForm();

      closePanel(
        "cartPanel"
      );

      openPanel(
        "informationPanel"
      );

    }
  );

/* =====================================================
   INFORMATION FORM
===================================================== */

function generateReference(){

  return String(
    Math.floor(
      1000 +
      Math.random() *
      9000
    )
  );

}

function prepareInformationForm(){

  const code =
    generateReference();

  document.getElementById(
    "referenceDisplay"
  ).textContent = code;

  document.getElementById(
    "formReference"
  ).value = code;

  updateFormHiddenFields();

}

function updateFormHiddenFields(){

  const productsText =
    selectedProducts
      .map(
        item =>
          `${item.name} x${item.quantity} - $${(
            item.price *
            item.quantity
          ).toFixed(2)}`
      )
      .join("\n");

  const sub =
    subtotal();

  const shippingCost =
    getShippingCost();

  const total =
    sub + shippingCost;

  document.getElementById(
    "formProducts"
  ).value =
    productsText;

  document.getElementById(
    "formSubtotal"
  ).value =
    "$" + sub.toFixed(2);

  document.getElementById(
    "formShipping"
  ).value =
    getShippingName();

  document.getElementById(
    "formShippingCost"
  ).value =
    "$" + shippingCost.toFixed(2);

  document.getElementById(
    "formTotal"
  ).value =
    "$" + total.toFixed(2);

  document.getElementById(
    "formPayment"
  ).value =
    getPayment();

}

function saveLastOrder(reference){

  const shippingCost =
    getShippingCost();

  const sub =
    subtotal();

  const order = {

    reference:reference,

    products:selectedProducts,

    subtotal:sub,

    shipping:getShippingName(),

    shippingCost:shippingCost,

    total:
      sub +
      shippingCost,

    payment:getPayment(),

    createdAt:
      new Date().toISOString()

  };

  setStorage(
    STORAGE.lastOrder,
    order
  );

  return order;

}

/* =====================================================
   PAYMENT INFORMATION
===================================================== */

function showPaymentInformation(order){

  const box =
    document.getElementById(
      "paymentFinal"
    );

  let html = `

    <p>
      <strong>Order number:</strong>
      ${escapeHtml(order.reference)}
    </p>

    <p>
      <strong>Amount:</strong>
      $${order.total.toFixed(2)}
    </p>

  `;

  if(
    order.payment ===
    "zelle"
  ){

    html += `

      <div class="payment zelle">

        <h3>Zelle</h3>

        <p>
          <strong>Name:</strong>
          Araceli Hernández
        </p>

        <p>
          <strong>Phone:</strong>
          (832) 273-9625
        </p>

        <p>
          Send the amount shown above through Zelle.
        </p>

        <p>
          Please place your order number in the memo.
        </p>

      </div>

    `;

  }

  if(
    order.payment ===
    "venmo"
  ){

    html += `

      <div class="payment venmo">

        <h3>Venmo</h3>

        <p>
          <strong>Venmo:</strong>
          @novapeps22
        </p>

        <p>
          <strong>Name:</strong>
          Araceli Hernández
        </p>

        <p>
          Send the amount shown above through Venmo.
        </p>

        <p>
          Please place your order number in the memo.
        </p>

        <button
          class="copy-btn"
          type="button"
          onclick="copyText('@novapeps22')"
        >
          Copy Venmo
        </button>

      </div>

    `;

  }

  if(
    order.payment ===
    "paypal"
  ){

    html += `

      <div class="payment paypal">

        <h3>PayPal</h3>

        <p>
          <strong>PayPal:</strong>
          Add your PayPal information here.
        </p>

        <p>
          <strong>Amount:</strong>
          $${order.total.toFixed(2)}
        </p>

        <p>
          Please use your order number as the payment reference.
        </p>

      </div>

    `;

  }

  box.innerHTML =
    html;

}

/* =====================================================
   FORMSPREE
===================================================== */

document
  .getElementById("informationForm")
  .addEventListener(
    "submit",
    async function(event){

      event.preventDefault();

      const form =
        this;

      const button =
        form.querySelector(
          'button[type="submit"]'
        );

      const reference =
        document.getElementById(
          "formReference"
        ).value;

      if(!reference){

        prepareInformationForm();

      }

      updateFormHiddenFields();

      button.disabled = true;

      button.textContent =
        "SENDING...";

      try{

        const response =
          await fetch(
            form.action,
            {
              method:"POST",

              body:
                new FormData(form),

              headers:{
                "Accept":
                  "application/json"
              }
            }
          );

        if(!response.ok){

          throw new Error(
            "Submission failed"
          );

        }

        const order =
          saveLastOrder(
            document.getElementById(
              "formReference"
            ).value
          );

        form.style.display =
          "none";

        document
          .getElementById(
            "finalConfirmation"
          )
          .style.display =
          "block";

        showPaymentInformation(
          order
        );

      }catch(error){

        alert(
          "There was a problem sending the information. Please try again."
        );

        button.disabled =
          false;

        button.textContent =
          "SEND INFORMATION";

      }

    }
  );

/* =====================================================
   COPY
===================================================== */

function copyText(text){

  if(
    navigator.clipboard &&
    navigator.clipboard.writeText
  ){

    navigator.clipboard
      .writeText(text)
      .then(
        function(){

          alert(
            "Information copied"
          );

        }
      )
      .catch(
        function(){

          fallbackCopy(text);

        }
      );

  }else{

    fallbackCopy(text);

  }

}

function fallbackCopy(text){

  const textarea =
    document.createElement(
      "textarea"
    );

  textarea.value =
    text;

  document.body.appendChild(
    textarea
  );

  textarea.select();

  try{

    document.execCommand(
      "copy"
    );

    alert(
      "Information copied"
    );

  }catch(error){

    alert(
      "Could not copy the information."
    );

  }

  document.body.removeChild(
    textarea
  );

}

/* =====================================================
   FAVORITES
===================================================== */

function loadFavorites(){

  favorites =
    getStorage(
      STORAGE.favorites,
      []
    );

  document
    .querySelectorAll(
      ".favorite-btn"
    )
    .forEach(
      button => {

        const name =
          button.dataset.favorite;

        if(
          favorites.includes(name)
        ){

          button.classList.add(
            "active"
          );

          button.textContent =
            "♥";

        }

      }
    );

}

document
  .querySelectorAll(
    ".favorite-btn"
  )
  .forEach(
    button => {

      button.addEventListener(
        "click",
        function(event){

          event.stopPropagation();

          const name =
            this.dataset.favorite;

          if(
            favorites.includes(name)
          ){

            favorites =
              favorites.filter(
                item =>
                  item !== name
              );

            this.classList.remove(
              "active"
            );

            this.textContent =
              "♡";

          }else{

            favorites.push(
              name
            );

            this.classList.add(
              "active"
            );

            this.textContent =
              "♥";

          }

          setStorage(
            STORAGE.favorites,
            favorites
          );

        }
      );

    }
  );

/* =====================================================
   PRODUCT MODAL
===================================================== */

function openProductModal(
  product
){

  modalProduct =
    product;

  modalQuantity =
    1;

  document.getElementById(
    "modalImage"
  ).src =
    product.image;

  document.getElementById(
    "modalImage"
  ).alt =
    product.name;

  document.getElementById(
    "modalName"
  ).textContent =
    product.name;

  document.getElementById(
    "modalPrice"
  ).textContent =
    "$" +
    product.price.toFixed(2);

  document.getElementById(
    "modalQuantity"
  ).textContent =
    modalQuantity;

  document.getElementById(
    "productModal"
  ).classList.add(
    "open"
  );

}

function closeProductModal(){

  document.getElementById(
    "productModal"
  ).classList.remove(
    "open"
  );

  modalProduct =
    null;

}

function changeModalQuantity(
  change
){

  modalQuantity +=
    change;

  if(
    modalQuantity < 1
  ){

    modalQuantity =
      1;

  }

  document.getElementById(
    "modalQuantity"
  ).textContent =
    modalQuantity;

}

document
  .getElementById(
    "modalClose"
  )
  .addEventListener(
    "click",
    closeProductModal
  );

document
  .getElementById(
    "modalMinus"
  )
  .addEventListener(
    "click",
    () =>
      changeModalQuantity(-1)
  );

document
  .getElementById(
    "modalPlus"
  )
  .addEventListener(
    "click",
    () =>
      changeModalQuantity(1)
  );

document
  .getElementById(
    "modalAdd"
  )
  .addEventListener(
    "click",
    function(){

      if(!modalProduct){
        return;
      }

      addToList(
        modalProduct,
        modalQuantity
      );

      closeProductModal();

      openPanel(
        "listPanel"
      );

    }
  );

document
  .getElementById(
    "modalGoCart"
  )
  .addEventListener(
    "click",
    function(){

      if(modalProduct){

        addToList(
          modalProduct,
          modalQuantity
        );

      }

      closeProductModal();

      openPanel(
        "cartPanel"
      );

    }
  );

document
  .getElementById(
    "productModal"
  )
  .addEventListener(
    "click",
    function(event){

      if(
        event.target === this
      ){

        closeProductModal();

      }

    }
  );

/* =====================================================
   PRODUCT BUTTONS
===================================================== */

document
  .querySelectorAll(
    ".product-card"
  )
  .forEach(
    card => {

      const image =
        card.querySelector(
          ".product-image"
        );

      const addButton =
        card.querySelector(
          ".add-list-btn"
        );

      const product = {

        name:
          card.dataset.name,

        price:
          Number(
            card.dataset.price
          ),

        image:
          card.dataset.image

      };

      image.addEventListener(
        "click",
        function(){

          openProductModal(
            product
          );

        }
      );

      addButton.addEventListener(
        "click",
        function(){

          addToList(
            product,
            1
          );

          this.textContent =
            "ADDED ✓";

          setTimeout(
            () => {

              this.textContent =
                "ADD TO LIST";

            },
            1200
          );

        }
      );

    }
  );

/* =====================================================
   SEARCH
===================================================== */

const searchInput =
  document.getElementById(
    "searchInput"
  );

const searchResults =
  document.getElementById(
    "searchResults"
  );

function renderSearchResults(){

  const query =
    normalize(
      searchInput.value.trim()
    );

  if(!query){

    searchResults.innerHTML =
      "";

    return;

  }

  const results =
    PRODUCTS.filter(
      product =>
        normalize(
          product.name
        ).includes(query)
    );

  if(
    results.length === 0
  ){

    searchResults.innerHTML =
      '<div class="notice">No products found.</div>';

    return;

  }

  searchResults.innerHTML =
    results
      .map(
        product => `

          <div
            class="search-result"
            data-search-name="${escapeHtml(product.name)}"
          >

            <strong>
              ${escapeHtml(product.name)}
            </strong>

            —
            $${product.price.toFixed(2)}

          </div>

        `
      )
      .join("");

}

searchInput.addEventListener(
  "input",
  renderSearchResults
);

searchResults.addEventListener(
  "click",
  function(event){

    const item =
      event.target.closest(
        ".search-result"
      );

    if(!item){
      return;
    }

    const product =
      findProduct(
        item.dataset.searchName
      );

    if(product){

      addToList(
        product,
        1
      );

      searchInput.value =
        "";

      searchResults.innerHTML =
        "";

      openPanel(
        "listPanel"
      );

    }

  }
);

/* =====================================================
   NAVIGATION
===================================================== */

document
  .querySelectorAll(
    ".menu-link"
  )
  .forEach(
    link => {

      link.addEventListener(
        "click",
        function(){

          const href =
            this.getAttribute(
              "href"
            );

          if(
            href &&
            href.startsWith("#")
          ){

            closeAllPanels();

            setTimeout(
              () => {

                const element =
                  document.querySelector(
                    href
                  );

                if(element){

                  element.scrollIntoView({
                    behavior:"smooth"
                  });

                }

              },
              50
            );

          }

        }
      );

    }
  );

/* =====================================================
   LOGO / HOME
===================================================== */

document
  .querySelector(
    ".brand-logo"
  )
  .addEventListener(
    "click",
    function(){

      closeAllPanels();

    }
  );

/* =====================================================
   ESCAPE HELPERS
===================================================== */

function escapeHtml(text){

  return String(text)

    .replace(
      /&/g,
      "&amp;"
    )

    .replace(
      /</g,
      "&lt;"
    )

    .replace(
      />/g,
      "&gt;"
    )

    .replace(
      /"/g,
      "&quot;"
    )

    .replace(
      /'/g,
      "&#039;"
    );

}

function escapeJs(text){

  return String(text)

    .replace(
      /\\/g,
      "\\\\"
    )

    .replace(
      /'/g,
      "\\'"
    );

}

/* =====================================================
   INITIALIZATION
===================================================== */

selectedProducts =
  getStorage(
    STORAGE.selected,
    []
  );

initializeAgeGate();

restoreOptions();

loadFavorites();

renderSelectedProducts();

renderCart();

updateCartCount();

</script>

</body>
</html>
