<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NovaPeps USA</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#fff;
  color:#0b1220;
}

body.locked{
  overflow:hidden;
}

/* =====================================================
   PREMIUM HEADER
===================================================== */

.site-header{
  position:sticky;
  top:0;
  z-index:5000;
  height:88px;
  background:#050b16;
  color:#fff;
  display:grid;
  grid-template-columns:1fr auto 1fr;
  align-items:center;
  padding:0 28px;
  box-shadow:0 4px 24px rgba(0,0,0,.28);
  border-bottom:1px solid rgba(73,163,255,.16);
}

.menu-btn{
  width:48px;
  height:48px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:14px;
  background:rgba(255,255,255,.05);
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  gap:5px;
  cursor:pointer;
  transition:.2s ease;
  justify-self:start;
}

.menu-btn:hover{
  background:rgba(45,143,255,.16);
  border-color:rgba(45,143,255,.45);
}

.menu-btn span{
  display:block;
  width:23px;
  height:2px;
  background:#fff;
  border-radius:5px;
}

.brand-logo{
  display:flex;
  align-items:center;
  justify-content:center;
  height:100%;
  text-decoration:none;
}

.brand-logo img{
  display:block;
  width:auto;
  max-width:190px;
  max-height:66px;
  object-fit:contain;
}

.header-actions{
  display:flex;
  justify-content:flex-end;
  align-items:center;
  gap:10px;
}

.header-icon{
  position:relative;
  width:48px;
  height:48px;
  border:1px solid rgba(255,255,255,.12);
  border-radius:14px;
  background:rgba(255,255,255,.05);
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  transition:.2s ease;
}

.header-icon:hover{
  background:rgba(45,143,255,.16);
  border-color:rgba(45,143,255,.45);
}

.header-icon svg{
  width:24px;
  height:24px;
  fill:none;
  stroke:currentColor;
  stroke-width:2;
  stroke-linecap:round;
  stroke-linejoin:round;
}

.header-cart-count{
  position:absolute;
  top:-5px;
  right:-5px;
  min-width:22px;
  height:22px;
  padding:0 5px;
  border-radius:20px;
  background:#1688ff;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:11px;
  font-weight:900;
  border:2px solid #050b16;
}

/* =====================================================
   HERO
===================================================== */

.hero{
  min-height:505px;
  position:relative;
  background-image:
    linear-gradient(
      90deg,
      rgba(3,10,22,.72),
      rgba(3,10,22,.20),
      rgba(3,10,22,.48)
    ),
    url("./att.tK5Us77ej-aCYPmzLGG1MqUszdTsZL0nehl0NVAVGC0.jpeg");
  background-size:cover;
  background-position:center;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  color:#fff;
  padding:50px 20px;
}

.hero-content{
  max-width:900px;
}

.hero-content h1{
  font-size:clamp(42px,7vw,76px);
  font-weight:900;
  letter-spacing:5px;
  margin-bottom:15px;
  text-shadow:0 4px 24px rgba(0,0,0,.75);
}

.hero-content p{
  display:inline-block;
  font-size:16px;
  letter-spacing:3px;
  text-transform:uppercase;
  font-weight:800;
  padding:10px 18px;
  border:1px solid rgba(255,255,255,.35);
  border-radius:30px;
  background:rgba(0,0,0,.28);
  backdrop-filter:blur(6px);
}

/* =====================================================
   GENERAL
===================================================== */

.section{
  max-width:1400px;
  padding:75px 28px;
  margin:auto;
  scroll-margin-top:95px;
}

.section-title{
  position:relative;
  text-align:center;
  font-size:clamp(30px,4vw,46px);
  margin-bottom:48px;
  font-weight:900;
  color:#08152a;
  letter-spacing:-.8px;
}

.section-title::after{
  content:"";
  display:block;
  width:72px;
  height:4px;
  margin:15px auto 0;
  border-radius:10px;
  background:#1688ff;
  box-shadow:0 3px 12px rgba(22,136,255,.25);
}

.notice{
  text-align:center;
  color:#687386;
  font-size:14px;
  margin-top:15px;
}

/* =====================================================
   PRODUCTS
===================================================== */

.products-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:28px;
}

.product-card{
  position:relative;
  background:#fff;
  border:1px solid #e3eaf3;
  border-radius:24px;
  overflow:hidden;
  box-shadow:
    0 10px 35px rgba(5,27,55,.08),
    0 2px 7px rgba(5,27,55,.04);
  transition:.28s ease;
}

.product-card:hover{
  transform:translateY(-7px);
  border-color:#cbdff5;
  box-shadow:
    0 18px 45px rgba(5,27,55,.13),
    0 4px 12px rgba(22,136,255,.08);
}

.product-image-wrap{
  position:relative;
  min-height:330px;
  padding:25px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:
    radial-gradient(
      circle at 50% 35%,
      rgba(255,255,255,.98),
      rgba(232,243,253,.98)
    );
  border-bottom:1px solid #e2edf8;
}

.product-image{
  display:block;
  width:100%;
  height:285px;
  object-fit:contain;
  cursor:pointer;
  filter:drop-shadow(0 13px 14px rgba(0,31,66,.14));
  transition:.3s ease;
}

.product-card:hover .product-image{
  transform:scale(1.045);
}

.favorite-btn{
  position:absolute;
  top:15px;
  right:15px;
  width:44px;
  height:44px;
  border-radius:50%;
  border:1px solid #d9e3ef;
  background:rgba(255,255,255,.95);
  color:#657286;
  cursor:pointer;
  font-size:23px;
  z-index:2;
  box-shadow:0 5px 16px rgba(0,0,0,.08);
  transition:.2s ease;
}

.favorite-btn:hover{
  color:#1688ff;
  border-color:#8fc6ff;
  transform:scale(1.05);
}

.favorite-btn.active{
  color:#1688ff;
  border-color:#8fc6ff;
  background:#f0f8ff;
}

.product-info{
  padding:23px 22px 25px;
  text-align:center;
}

.product-info h3{
  font-size:18px;
  color:#101b2c;
  margin-bottom:9px;
  font-weight:900;
}

.product-price{
  font-size:25px;
  color:#071b35;
  font-weight:900;
  margin-bottom:8px;
}

.research{
  font-size:10px;
  color:#778398;
  letter-spacing:.8px;
  font-weight:900;
  margin-bottom:17px;
}

.add-list-btn{
  width:100%;
  border:2px solid #1688ff;
  background:#fff;
  color:#0c62b9;
  padding:13px;
  border-radius:13px;
  font-weight:900;
  letter-spacing:.4px;
  cursor:pointer;
  transition:.2s ease;
}

.add-list-btn:hover{
  background:#1688ff;
  color:#fff;
  box-shadow:0 7px 20px rgba(22,136,255,.22);
}

/* =====================================================
   FLOATING CART
===================================================== */

.cart-floating{
  position:fixed;
  right:22px;
  bottom:22px;
  width:64px;
  height:64px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,.15);
  background:#071525;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  z-index:4500;
  box-shadow:0 9px 30px rgba(0,0,0,.28);
  transition:.2s ease;
}

.cart-floating:hover{
  transform:translateY(-3px);
  background:#0b2540;
}

.cart-floating svg{
  width:27px;
  height:27px;
  fill:none;
  stroke:#fff;
  stroke-width:2;
  stroke-linecap:round;
  stroke-linejoin:round;
}

.cart-count{
  position:absolute;
  top:-5px;
  right:-5px;
  min-width:25px;
  height:25px;
  padding:0 5px;
  border-radius:50%;
  background:#1688ff;
  color:#fff;
  border:2px solid #fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:11px;
  font-weight:900;
}

/* =====================================================
   SIDE MENU
===================================================== */

.overlay{
  position:fixed;
  inset:0;
  background:rgba(1,8,18,.62);
  backdrop-filter:blur(3px);
  z-index:6000;
  display:none;
}

.overlay.show{
  display:block;
}

.side-menu{
  position:fixed;
  top:0;
  left:-360px;
  width:335px;
  max-width:92%;
  height:100vh;
  background:#fff;
  z-index:7000;
  transition:.32s ease;
  padding:25px;
  overflow-y:auto;
  box-shadow:10px 0 35px rgba(0,0,0,.2);
}

.side-menu.open{
  left:0;
}

.side-close{
  border:0;
  background:#071525;
  color:#fff;
  width:42px;
  height:42px;
  border-radius:50%;
  font-size:23px;
  cursor:pointer;
  float:right;
}

.side-menu h2{
  clear:both;
  padding-top:25px;
  margin-bottom:20px;
  color:#071525;
}

.side-menu a,
.side-menu button.menu-link{
  display:block;
  width:100%;
  padding:15px 8px;
  border:0;
  border-bottom:1px solid #e8edf3;
  background:none;
  text-align:left;
  color:#172235;
  text-decoration:none;
  font-weight:800;
  cursor:pointer;
  transition:.2s ease;
}

.side-menu a:hover,
.side-menu button.menu-link:hover{
  color:#1688ff;
  padding-left:14px;
}

.search-box{
  margin:20px 0;
}

.search-box input{
  width:100%;
  padding:14px;
  border:1px solid #d5dfeb;
  border-radius:12px;
  outline:none;
}

.search-box input:focus{
  border-color:#1688ff;
  box-shadow:0 0 0 3px rgba(22,136,255,.1);
}

.search-results{
  margin-top:10px;
}

.search-result{
  padding:11px;
  border-bottom:1px solid #eee;
  cursor:pointer;
  border-radius:8px;
}

.search-result:hover{
  background:#f0f7ff;
}

/* =====================================================
   PANELS
===================================================== */

.panel{
  position:fixed;
  top:0;
  right:-520px;
  width:500px;
  max-width:95%;
  height:100vh;
  background:#fff;
  z-index:8000;
  transition:.3s ease;
  overflow-y:auto;
  padding:28px;
  box-shadow:-8px 0 35px rgba(0,0,0,.2);
}

.panel.open{
  right:0;
}

.panel-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:22px;
  padding-bottom:15px;
  border-bottom:1px solid #e6ebf1;
}

.panel-header h2{
  color:#071525;
}

.panel-close{
  width:40px;
  height:40px;
  border:0;
  border-radius:50%;
  background:#071525;
  color:#fff;
  cursor:pointer;
  font-size:20px;
}

/* =====================================================
   SELECTED PRODUCTS
===================================================== */

.selected-item{
  display:flex;
  align-items:center;
  gap:13px;
  border-bottom:1px solid #e7ebf0;
  padding:14px 0;
}

.selected-item img{
  width:70px;
  height:70px;
  object-fit:contain;
  background:#eef6fd;
  border-radius:12px;
}

.selected-info{
  flex:1;
}

.qty-controls{
  display:flex;
  align-items:center;
  gap:8px;
  margin-top:8px;
  flex-wrap:wrap;
}

.qty-controls button{
  width:31px;
  height:31px;
  border:1px solid #ccd7e4;
  background:#fff;
  border-radius:8px;
  cursor:pointer;
}

.qty-controls button:hover{
  border-color:#1688ff;
  color:#1688ff;
}

.remove-btn{
  border:0;
  background:#edf1f5;
  padding:7px 9px;
  border-radius:7px;
  cursor:pointer;
}

.cart-summary{
  margin-top:20px;
  padding-top:15px;
  border-top:2px solid #071525;
}

.summary-row{
  display:flex;
  justify-content:space-between;
  padding:7px 0;
}

.summary-row.total{
  font-size:21px;
  font-weight:900;
  color:#071525;
  margin-top:8px;
}

/* =====================================================
   SHIPPING / PAYMENT
===================================================== */

.option-box{
  margin-top:22px;
}

.option-box h3{
  margin-bottom:11px;
  color:#071525;
}

.option-label{
  display:block;
  border:1px solid #dbe3ed;
  padding:14px;
  border-radius:11px;
  margin-bottom:9px;
  cursor:pointer;
  transition:.2s ease;
  background:#fff;
}

.option-label:hover{
  border-color:#8ec8ff;
  background:#f7fbff;
}

.option-label:has(input:checked){
  border-color:#1688ff;
  background:#eef7ff;
  box-shadow:0 0 0 1px #1688ff inset;
}

.option-label input{
  margin-right:8px;
  accent-color:#1688ff;
}

.primary-btn{
  width:100%;
  padding:15px;
  border:0;
  border-radius:13px;
  background:#071525;
  color:#fff;
  font-weight:900;
  cursor:pointer;
  margin-top:15px;
  transition:.2s ease;
}

.primary-btn:hover{
  background:#1688ff;
  box-shadow:0 8px 22px rgba(22,136,255,.2);
}

.primary-btn:disabled{
  opacity:.6;
  cursor:not-allowed;
}

.secondary-btn{
  width:100%;
  padding:13px;
  border:1px solid #071525;
  border-radius:13px;
  background:#fff;
  color:#071525;
  font-weight:900;
  cursor:pointer;
  margin-top:10px;
}

.secondary-btn:hover{
  border-color:#1688ff;
  color:#1688ff;
}

/* =====================================================
   PAYMENT CARDS
===================================================== */

.payment{
  border:1px solid #dfe6ee;
  border-radius:14px;
  padding:18px;
  margin:15px 0;
  background:#fbfdff;
}

.payment h3{
  margin-bottom:12px;
  font-size:20px;
}

.payment p{
  margin:7px 0;
}

.venmo h3{
  color:#008cff;
}

.zelle h3{
  color:#6d1ed4;
}

.paypal h3{
  color:#003087;
}

.copy-btn{
  border:none;
  border-radius:8px;
  padding:9px 13px;
  margin-top:8px;
  cursor:pointer;
  font-weight:bold;
  background:#071525;
  color:#fff;
}

/* =====================================================
   INFORMATION FORM
===================================================== */

.form-group{
  margin-bottom:14px;
}

.form-group label{
  display:block;
  font-weight:bold;
  margin-bottom:6px;
}

.form-group input,
.form-group textarea,
.form-group select{
  width:100%;
  padding:12px;
  border:1px solid #ccd7e4;
  border-radius:9px;
  font:inherit;
  outline:none;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus{
  border-color:#1688ff;
  box-shadow:0 0 0 3px rgba(22,136,255,.1);
}

.form-group textarea{
  min-height:110px;
  resize:vertical;
}

.reference-box{
  background:#eef7ff;
  border:1px solid #d5eaff;
  border-radius:12px;
  padding:14px;
  margin:15px 0;
  text-align:center;
}

.reference-code{
  font-size:28px;
  color:#071525;
  font-weight:900;
  letter-spacing:3px;
}

/* =====================================================
   MODAL
===================================================== */

.modal{
  position:fixed;
  inset:0;
  background:rgba(1,8,18,.78);
  backdrop-filter:blur(4px);
  z-index:9000;
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px;
}

.modal.open{
  display:flex;
}

.modal-content{
  width:520px;
  max-width:100%;
  background:#fff;
  border-radius:24px;
  padding:28px;
  max-height:90vh;
  overflow-y:auto;
  position:relative;
  box-shadow:0 20px 70px rgba(0,0,0,.35);
}

.modal-close{
  position:absolute;
  top:14px;
  right:14px;
  width:40px;
  height:40px;
  border:0;
  border-radius:50%;
  background:#071525;
  color:#fff;
  cursor:pointer;
  font-size:20px;
}

.modal-image{
  width:100%;
  height:320px;
  object-fit:contain;
  margin-bottom:15px;
  background:#f1f8ff;
  border-radius:18px;
}

.modal-content h2{
  margin-bottom:8px;
  color:#071525;
}

.modal-price{
  font-size:25px;
  font-weight:900;
  margin-bottom:15px;
}

/* =====================================================
   COMPARE
===================================================== */

.compare-wrap{
  overflow-x:auto;
}

.compare-table{
  width:100%;
  border-collapse:separate;
  border-spacing:0;
  min-width:600px;
  overflow:hidden;
  border-radius:14px;
}

.compare-table th,
.compare-table td{
  border:1px solid #dfe6ee;
  padding:14px;
  text-align:center;
}

.compare-table th{
  background:#071525;
  color:#fff;
}

.compare-table tr:nth-child(even) td{
  background:#f7faff;
}

/* =====================================================
   CONTACT / ABOUT / LOGIN
===================================================== */

.info-card{
  max-width:850px;
  margin:auto;
  background:#f7faff;
  border:1px solid #e2eaf3;
  padding:32px;
  border-radius:20px;
  line-height:1.7;
  box-shadow:0 8px 28px rgba(5,27,55,.05);
}

.contact-info{
  text-align:center;
  font-size:18px;
  line-height:2;
}

.login-box{
  max-width:450px;
  margin:auto;
  background:#f7faff;
  border:1px solid #e2eaf3;
  padding:30px;
  border-radius:20px;
}

.login-box input{
  width:100%;
  padding:13px;
  margin-bottom:12px;
  border:1px solid #ccd7e4;
  border-radius:9px;
}

/* =====================================================
   FINAL CONFIRMATION
===================================================== */

.thank-you{
  text-align:center;
  padding:30px 10px;
}

.thank-you h2{
  font-size:34px;
  margin-bottom:15px;
  color:#071525;
}

.payment-final{
  text-align:left;
  margin-top:20px;
  padding:18px;
  background:#f4f8fc;
  border:1px solid #dfe7f0;
  border-radius:14px;
}

/* =====================================================
   AGE GATE
===================================================== */

.age-gate{
  position:fixed;
  inset:0;
  z-index:10000;
  background:rgba(2,8,18,.95);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
}

.age-gate.hidden{
  display:none !important;
}

.age-card{
  width:500px;
  max-width:100%;
  background:#fff;
  border-radius:24px;
  padding:38px 27px;
  text-align:center;
  box-shadow:0 10px 60px rgba(0,0,0,.55);
  border:1px solid #dce8f5;
}

.age-card h2{
  font-size:30px;
  color:#071525;
  margin-bottom:15px;
}

.age-card p{
  color:#555;
  line-height:1.6;
  margin-bottom:25px;
}

.age-buttons{
  display:flex;
  gap:12px;
}

.age-buttons button{
  flex:1;
  padding:15px 10px;
  border-radius:12px;
  font-weight:900;
  cursor:pointer;
}

.age-enter{
  background:#071525;
  color:#fff;
  border:2px solid #071525;
}

.age-enter:hover{
  background:#1688ff;
  border-color:#1688ff;
}

.age-exit{
  background:#fff;
  color:#071525;
  border:2px solid #071525;
}

/* =====================================================
   FOOTER
===================================================== */

footer{
  background:#050b16;
  color:#fff;
  text-align:center;
  padding:40px 20px;
  margin-top:40px;
}

footer p{
  margin:7px 0;
}

.status{
  padding:12px;
  background:#f1f5f9;
  border-radius:10px;
  margin-top:12px;
  text-align:center;
  display:none;
}

/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width:1100px){

  .products-grid{
    grid-template-columns:repeat(2,1fr);
  }

}

@media(max-width:700px){

  .site-header{
    height:72px;
    padding:0 14px;
    grid-template-columns:1fr auto 1fr;
  }

  .brand-logo img{
    max-width:145px;
    max-height:53px;
  }

  .menu-btn,
  .header-icon{
    width:43px;
    height:43px;
  }

  .header-actions{
    gap:6px;
  }

  .header-icon svg{
    width:21px;
    height:21px;
  }

  .hero{
    min-height:390px;
  }

  .hero-content h1{
    font-size:39px;
    letter-spacing:3px;
  }

  .hero-content p{
    font-size:12px;
    letter-spacing:2px;
  }

  .section{
    padding:55px 15px;
  }

  .section-title{
    font-size:30px;
    margin-bottom:34px;
  }

  .products-grid{
    grid-template-columns:1fr;
    gap:22px;
  }

  .product-image-wrap{
    min-height:350px;
  }

  .product-image{
    height:310px;
  }

  .panel{
    width:100%;
    max-width:100%;
    padding:22px 18px;
  }

  .age-buttons{
    flex-direction:column;
  }

  .cart-floating{
    right:16px;
    bottom:16px;
  }

}

@media(max-width:420px){

  .site-header{
    padding:0 10px;
  }

  .brand-logo img{
    max-width:125px;
  }

  .menu-btn,
  .header-icon{
    width:40px;
    height:40px;
    border-radius:12px;
  }

  .header-actions{
    gap:4px;
  }

  .hero-content h1{
    font-size:32px;
  }

  .product-image-wrap{
    min-height:320px;
  }

  .product-image{
    height:280px;
  }

}
</style>
</head>

<body>

<!-- =====================================================
     AGE CONFIRMATION
===================================================== -->

<div class="age-gate" id="ageGate">

  <div class="age-card">

    <h2>Age Confirmation</h2>

    <p>
      This website contains products presented for research purposes only.<br>
      Please confirm that you are of legal age to enter this website.
    </p>

    <div class="age-buttons">

      <button
        class="age-enter"
        id="ageEnterBtn"
        type="button"
      >
        I AM OF LEGAL AGE
      </button>

      <button
        class="age-exit"
        id="ageExitBtn"
        type="button"
      >
        EXIT
      </button>

    </div>

  </div>

</div>

<!-- =====================================================
     PREMIUM HEADER
===================================================== -->

<header class="site-header">

  <button
    class="menu-btn"
    id="menuBtn"
    type="button"
    aria-label="Open menu"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <a
    href="#home"
    class="brand-logo"
    aria-label="NovaPeps USA Home"
  >
    <img
      src="./logo.png"
      alt="NovaPeps USA"
    >
  </a>

  <div class="header-actions">

    <!-- SEARCH -->
    <button
      class="header-icon"
      id="headerSearchBtn"
      type="button"
      aria-label="Search products"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M16.5 16.5L22 22"></path>
      </svg>
    </button>

    <!-- CART -->
    <button
      class="header-icon"
      id="headerCartBtn"
      type="button"
      aria-label="Shopping cart"
    >

      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 1.9-1.5L21 8H7"></path>
        <circle cx="10" cy="20" r="1.5"></circle>
        <circle cx="18" cy="20" r="1.5"></circle>
      </svg>

      <span
        class="header-cart-count"
        id="headerCartCount"
      >
        0
      </span>

    </button>

  </div>

</header>

<!-- =====================================================
     SIDE MENU
===================================================== -->

<div
  class="overlay"
  id="overlay"
></div>

<nav
  class="side-menu"
  id="sideMenu"
>

  <button
    class="side-close"
    id="sideClose"
    type="button"
  >
    ×
  </button>

  <h2>NOVAPEPS USA</h2>

  <div class="search-box">

    <input
      type="search"
      id="searchInput"
      placeholder="Search products..."
    >

    <div
      class="search-results"
      id="searchResults"
    ></div>

  </div>

  <a
    href="#home"
    class="menu-link"
  >
    HOME
  </a>

  <a
    href="#products"
    class="menu-link"
  >
    PRODUCTS
  </a>

  <button
    class="menu-link"
    data-open-panel="listPanel"
  >
    LIST
  </button>

  <a
    href="#shipping"
    class="menu-link"
  >
    SHIPPING
  </a>

  <a
    href="#contact"
    class="menu-link"
  >
    CONTACT PAGE
  </a>

  <a
    href="#about"
    class="menu-link"
  >
    ABOUT US
  </a>

  <a
    href="#compare"
    class="menu-link"
  >
