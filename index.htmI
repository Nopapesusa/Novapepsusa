<script>

const PRODUCTS=[
{name:"MOTS-C 10 MG",price:60,image:"./55A6F8D2-C2C2-4582-BFB3-B93DACC10C28.png"},
{name:"GLP-2 10 MG",price:90,image:"./5B460B8F-14FC-4B9A-9D17-339565C8ED0B.png"},
{name:"GHK-CU 100 MG",price:50,image:"./6747079A-BB69-4F51-A792-565688C6BC86.png"},
{name:"GLP-3 10 MG",price:95,image:"./713BA234-721B-4580-94DF-6677375C7826.png"},
{name:"GLP-2 20 MG",price:110,image:"./7855AC8E-4FC3-47C9-B16B-B62AD1C36BF0.png"},
{name:"GLP-3 20 MG",price:135,image:"./96BEC651-AA03-4D8D-9254-3FB8C8E85104.png"},
{name:"GLUTATHIONE 1500 MG",price:60,image:"./A6F31BD7-FD7A-4EBD-B2F8-080DF7896871.png"},
{name:"NAD+ 500 MG",price:50,image:"./EB389E57-904B-4E57-953C-407C50FA216A.png"}
];

const STORAGE={
selected:"novaSelectedProducts",
favorites:"novaFavoriteProducts",
shipping:"novaShippingOption",
payment:"novaPaymentOption",
age:"novaAgeConfirmed"
};

let selectedProducts=[];
let favorites=[];
let modalProduct=null;
let modalQuantity=1;

function getStorage(key,fallback){
try{
const value=localStorage.getItem(key);
return value===null?fallback:JSON.parse(value);
}catch(error){
return fallback;
}
}

function setStorage(key,value){
try{
localStorage.setItem(key,JSON.stringify(value));
}catch(error){}
}

/* AGE */

function enterSite(){
localStorage.setItem(STORAGE.age,"true");
document.getElementById("ageGate").classList.add("hidden");
document.body.classList.remove("locked");
}

function leaveSite(){
localStorage.removeItem(STORAGE.age);
document.body.innerHTML="<div style='padding:50px;text-align:center'><h1>Thank you.</h1></div>";
}

document.getElementById("ageEnterBtn").onclick=enterSite;
document.getElementById("ageExitBtn").onclick=leaveSite;

if(localStorage.getItem(STORAGE.age)==="true"){
document.getElementById("ageGate").classList.add("hidden");
}else{
document.body.classList.add("locked");
}

/* MENU */

function openMenu(){
document.getElementById("sideMenu").classList.add("open");
document.getElementById("overlay").classList.add("show");
}

/* FIXED DARK OVERLAY */

function closeMenu(){

document.getElementById("sideMenu").classList.remove("open");

const anyPanel=document.querySelector(".panel.open");

if(!anyPanel){
document.getElementById("overlay").classList.remove("show");
}

}

document.getElementById("menuBtn").onclick=openMenu;
document.getElementById("sideClose").onclick=closeMenu;

function openPanel(id){

closeMenu();

document.getElementById(id).classList.add("open");
document.getElementById("overlay").classList.add("show");

if(id==="listPanel")renderSelectedProducts();
if(id==="cartPanel")renderCart();

}

function closePanel(id){

document.getElementById(id).classList.remove("open");

if(
!document.querySelector(".panel.open") &&
!document.getElementById("sideMenu").classList.contains("open")
){
document.getElementById("overlay").classList.remove("show");
}

}

function closeAllPanels(){

document.querySelectorAll(".panel.open").forEach(panel=>{
panel.classList.remove("open");
});

document.getElementById("sideMenu").classList.remove("open");
document.getElementById("overlay").classList.remove("show");

closeProductModal();

}

document.getElementById("overlay").onclick=closeAllPanels;

document.querySelectorAll("[data-close-panel]").forEach(button=>{
button.onclick=function(){
closePanel(this.dataset.closePanel);
};
});

document.querySelectorAll("[data-open-panel]").forEach(button=>{
button.onclick=function(){
openPanel(this.dataset.openPanel);
};
});

document.getElementById("headerSearchBtn").onclick=function(){

openMenu();

setTimeout(()=>{
document.getElementById("searchInput").focus();
},200);

};

document.getElementById("headerCartBtn").onclick=function(){
openPanel("cartPanel");
};

document.getElementById("cartFloating").onclick=function(){
openPanel("cartPanel");
};

/* CART */

function subtotal(){

return selectedProducts.reduce(
(total,item)=>total+(item.price*item.quantity),
0
);

}

function saveSelected(){
setStorage(STORAGE.selected,selectedProducts);
}

function addToList(product,quantity=1){

const existing=selectedProducts.find(
item=>item.name===product.name
);

if(existing){
existing.quantity+=quantity;
}else{
selectedProducts.push({
...product,
quantity
});
}

saveSelected();
renderSelectedProducts();
renderCart();
updateCartCount();

}

function changeQuantity(name,change){

const item=selectedProducts.find(
product=>product.name===name
);

if(!item)return;

item.quantity+=change;

if(item.quantity<=0){
selectedProducts=selectedProducts.filter(
product=>product.name!==name
);
}

saveSelected();
renderSelectedProducts();
renderCart();
updateCartCount();

}

function removeProduct(name){

selectedProducts=selectedProducts.filter(
item=>item.name!==name
);

saveSelected();
renderSelectedProducts();
renderCart();
updateCartCount();

}

function renderSelectedProducts(){

const container=document.getElementById("selectedProducts");

if(!selectedProducts.length){

container.innerHTML='<p class="notice">No products selected.</p>';
document.getElementById("listTotal").textContent="$0.00";
return;

}

container.innerHTML=selectedProducts.map(item=>`

<div class="selected-item">

<img src="${item.image}">

<div class="selected-info">

<strong>${item.name}</strong>

<div>$${item.price.toFixed(2)}</div>

<div class="qty-controls">

<button onclick="changeQuantity('${item.name}',-1)">−</button>

<strong>${item.quantity}</strong>

<button onclick="changeQuantity('${item.name}',1)">+</button>

<button class="remove-btn" onclick="removeProduct('${item.name}')">
Remove
</button>

</div>

</div>

</div>

`).join("");

document.getElementById("listTotal").textContent=
"$"+subtotal().toFixed(2);

}

function updateCartCount(){

const count=selectedProducts.reduce(
(sum,item)=>sum+item.quantity,
0
);

document.getElementById("cartCount").textContent=count;
document.getElementById("headerCartCount").textContent=count;

}

function getShippingCost(){

const selected=document.querySelector(
'input[name="shipping"]:checked'
);

if(!selected)return 0;

if(selected.value==="standard")return 9;
if(selected.value==="express")return 15;

if(selected.value==="free"){
return subtotal()>=200?0:9;
}

return 0;

}

function getShippingName(){

const selected=document.querySelector(
'input[name="shipping"]:checked'
);

if(!selected)return "";

if(selected.value==="standard")return "Standard";
if(selected.value==="express")return "Express";
if(selected.value==="free")return "Free Shipping";

return "";

}

function getPayment(){

const selected=document.querySelector(
'input[name="payment"]:checked'
);

return selected?selected.value:"";

}

function renderCart(){

const container=document.getElementById("cartItems");

if(!selectedProducts.length){

container.innerHTML='<p class="notice">Your cart is empty.</p>';

}else{

container.innerHTML=selectedProducts.map(item=>`

<div class="selected-item">

<img src="${item.image}">

<div class="selected-info">

<strong>${item.name}</strong>

<div>$${item.price.toFixed(2)}</div>

<div class="qty-controls">

<button onclick="changeQuantity('${item.name}',-1)">−</button>

<strong>${item.quantity}</strong>

<button onclick="changeQuantity('${item.name}',1)">+</button>

<button class="remove-btn" onclick="removeProduct('${item.name}')">
Remove
</button>

</div>

</div>

</div>

`).join("");

}

updateTotals();

}

function updateTotals(){

const sub=subtotal();
const shipping=getShippingCost();
const total=sub+shipping;

document.getElementById("subtotal").textContent="$"+sub.toFixed(2);
document.getElementById("shippingCost").textContent="$"+shipping.toFixed(2);
document.getElementById("grandTotal").textContent="$"+total.toFixed(2);

updateFormHiddenFields();

}

document.querySelectorAll('input[name="shipping"]').forEach(input=>{

input.onchange=function(){

setStorage(STORAGE.shipping,this.value);

updateTotals();

};

});

document.querySelectorAll('input[name="payment"]').forEach(input=>{

input.onchange=function(){

setStorage(STORAGE.payment,this.value);

updateFormHiddenFields();

};

});

document.getElementById("openCartFromList").onclick=function(){

closePanel("listPanel");

openPanel("cartPanel");

};

document.getElementById("clearCartBtn").onclick=function(){

selectedProducts=[];

saveSelected();

renderSelectedProducts();

renderCart();

updateCartCount();

};

document.getElementById("checkoutBtn").onclick=function(){

if(!selectedProducts.length){

alert("Please select at least one product.");

return;

}

const shipping=document.querySelector(
'input[name="shipping"]:checked'
);

if(!shipping){

alert("Please select a shipping option.");

return;

}

if(
shipping.value==="free" &&
subtotal()<200
){

alert("Free Shipping is available only for orders of $200 or more.");

return;

}

if(!getPayment()){

alert("Please select a payment method.");

return;

}

prepareInformationForm();

closePanel("cartPanel");

openPanel("informationPanel");

};

/* FORM */

function generateReference(){

return String(
Math.floor(
1000+Math.random()*9000
)
);

}

function prepareInformationForm(){

const code=generateReference();

document.getElementById("referenceDisplay").textContent=code;

document.getElementById("formReference").value=code;

updateFormHiddenFields();

}

function updateFormHiddenFields(){

const productsText=selectedProducts.map(
item=>
`${item.name} x${item.quantity} - $${(item.price*item.quantity).toFixed(2)}`
).join("\n");

const sub=subtotal();
const shipping=getShippingCost();

document.getElementById("formProducts").value=productsText;

document.getElementById("formSubtotal").value=
"$"+sub.toFixed(2);

document.getElementById("formShipping").value=
getShippingName();

document.getElementById("formShippingCost").value=
"$"+shipping.toFixed(2);

document.getElementById("formTotal").value=
"$"+(sub+shipping).toFixed(2);

document.getElementById("formPayment").value=
getPayment();

}

/* =====================================================
   EMAIL VALIDATION
===================================================== */

const checkoutEmail=
document.getElementById("checkoutEmail");

const emailError=
document.getElementById("emailError");

function validateEmail(){

const value=checkoutEmail.value.trim();

const valid=
/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value);

checkoutEmail.classList.remove(
"field-error",
"field-valid"
);

emailError.classList.remove("show");

if(!valid){

checkoutEmail.classList.add("field-error");

emailError.classList.add("show");

return false;

}

checkoutEmail.classList.add("field-valid");

return true;

}

checkoutEmail.addEventListener(
"blur",
validateEmail
);

checkoutEmail.addEventListener(
"input",
function(){

if(this.classList.contains("field-error")){
validateEmail();
}

}
);

/* =====================================================
   PHONE VALIDATION + AUTOMATIC FORMAT
===================================================== */

const checkoutPhone=
document.getElementById("checkoutPhone");

const phoneError=
document.getElementById("phoneError");

function formatUSPhone(value){

let digits=value.replace(/\D/g,"");

if(
digits.length===11 &&
digits.startsWith("1")
){

digits=digits.substring(1);

}

digits=digits.substring(0,10);

if(digits.length<=3){

return digits;

}

if(digits.length<=6){

return `(${digits.substring(0,3)}) ${digits.substring(3)}`;

}

return `(${digits.substring(0,3)}) ${digits.substring(3,6)}-${digits.substring(6)}`;

}

checkoutPhone.addEventListener(
"input",
function(){

const digits=this.value.replace(/\D/g,"");

if(digits.length<=11){

this.value=formatUSPhone(this.value);

}

this.classList.remove(
"field-error",
"field-valid"
);

phoneError.classList.remove("show");

}
);

function validatePhone(){

const digits=
checkoutPhone.value.replace(/\D/g,"");

checkoutPhone.classList.remove(
"field-error",
"field-valid"
);

phoneError.classList.remove("show");

let valid=false;

if(digits.length===10){

valid=true;

}else if(
digits.length===11 &&
digits.startsWith("1")
){

valid=true;

}else if(
digits.length>=10 &&
digits.length<=15
){

valid=true;

}

if(!valid){

checkoutPhone.classList.add(
"field-error"
);

phoneError.classList.add(
"show"
);

return false;

}

checkoutPhone.classList.add(
"field-valid"
);

return true;

}

checkoutPhone.addEventListener(
"blur",
validatePhone
);

/* SUBMIT TO FORMSPREE */

document.getElementById("informationForm").addEventListener(
"submit",
async function(event){

event.preventDefault();

const form=this;

/* CHECK EMAIL AND PHONE BEFORE SENDING */

const emailIsValid=validateEmail();
const phoneIsValid=validatePhone();

if(
!emailIsValid ||
!phoneIsValid
){

const firstInvalid=
form.querySelector(".field-error");

if(firstInvalid){

firstInvalid.scrollIntoView({
behavior:"smooth",
block:"center"
});

firstInvalid.focus();

}

return;

}

const button=
form.querySelector(
'button[type="submit"]'
);

updateFormHiddenFields();

button.disabled=true;

button.textContent="SENDING...";

try{

const response=await fetch(
form.action,
{
method:"POST",
body:new FormData(form),
headers:{
"Accept":"application/json"
}
}
);

if(!response.ok){

throw new Error(
"Submission failed"
);

}

form.style.display="none";

document.getElementById(
"finalConfirmation"
).style.display="block";

const total=
subtotal()+getShippingCost();

const reference=
document.getElementById(
"formReference"
).value;

let html=`
<p><strong>Order number:</strong> ${reference}</p>
<p><strong>Amount:</strong> $${total.toFixed(2)}</p>
`;

const payment=getPayment();

if(payment==="zelle"){

html+=`

<div class="payment zelle">

<h3>Zelle</h3>

<p><strong>Name:</strong> Araceli Hernández</p>

<p><strong>Phone:</strong> (832) 273-9625</p>

<p>Send the amount shown above through Zelle.</p>

<p>Please place your order number in the memo.</p>

</div>

`;

}

if(payment==="venmo"){

html+=`

<div class="payment venmo">

<h3>Venmo</h3>

<p><strong>Venmo:</strong> @novapeps22</p>

<p><strong>Name:</strong> Araceli Hernández</p>

<p>Send the amount shown above through Venmo.</p>

<p>Please place your order number in the memo.</p>

</div>

`;

}

if(payment==="paypal"){

html+=`

<div class="payment paypal">

<h3>PayPal</h3>

<p><strong>PayPal:</strong> Add your PayPal information here.</p>

<p><strong>Amount:</strong> $${total.toFixed(2)}</p>

<p>Please use your order number as the payment reference.</p>

</div>

`;

}

document.getElementById(
"paymentFinal"
).innerHTML=html;

}catch(error){

alert(
"There was a problem sending the information. Please try again."
);

button.disabled=false;

button.textContent=
"SEND INFORMATION";

}

}
);

/* PRODUCTS */

document.querySelectorAll(
".product-card"
).forEach(card=>{

const product={
name:card.dataset.name,
price:Number(card.dataset.price),
image:card.dataset.image
};

card.querySelector(
".add-list-btn"
).onclick=function(){

addToList(product,1);

this.textContent="ADDED ✓";

setTimeout(()=>{
this.textContent="ADD TO LIST";
},1200);

};

card.querySelector(
".product-image"
).onclick=function(){

openProductModal(product);

};

});

/* MODAL */

function openProductModal(product){

modalProduct=product;

modalQuantity=1;

document.getElementById(
"modalImage"
).src=product.image;

document.getElementById(
"modalName"
).textContent=product.name;

document.getElementById(
"modalPrice"
).textContent="$"+product.price.toFixed(2);

document.getElementById(
"modalQuantity"
).textContent=1;

document.getElementById(
"productModal"
).classList.add("open");

}

function closeProductModal(){

document.getElementById(
"productModal"
).classList.remove("open");

modalProduct=null;

}

document.getElementById(
"modalClose"
).onclick=closeProductModal;

document.getElementById(
"modalMinus"
).onclick=function(){

modalQuantity=Math.max(
1,
modalQuantity-1
);

document.getElementById(
"modalQuantity"
).textContent=modalQuantity;

};

document.getElementById(
"modalPlus"
).onclick=function(){

modalQuantity++;

document.getElementById(
"modalQuantity"
).textContent=modalQuantity;

};

document.getElementById(
"modalAdd"
).onclick=function(){

if(!modalProduct)return;

addToList(
modalProduct,
modalQuantity
);

closeProductModal();

openPanel("listPanel");

};

document.getElementById(
"modalGoCart"
).onclick=function(){

if(modalProduct){

addToList(
modalProduct,
modalQuantity
);

}

closeProductModal();

openPanel("cartPanel");

};

/* FAVORITES */

favorites=
getStorage(
STORAGE.favorites,
[]
);

document.querySelectorAll(
".favorite-btn"
).forEach(button=>{

const name=
button.dataset.favorite;

if(favorites.includes(name)){

button.classList.add("active");

button.textContent="♥";

}

button.onclick=function(event){

event.stopPropagation();

if(favorites.includes(name)){

favorites=favorites.filter(
item=>item!==name
);

this.classList.remove("active");

this.textContent="♡";

}else{

favorites.push(name);

this.classList.add("active");

this.textContent="♥";

}

setStorage(
STORAGE.favorites,
favorites
);

};

});

/* SEARCH */

const searchInput=
document.getElementById(
"searchInput"
);

const searchResults=
document.getElementById(
"searchResults"
);

searchInput.addEventListener(
"input",
function(){

const query=
this.value
.trim()
.toLowerCase();

if(!query){

searchResults.innerHTML="";

return;

}

const results=
PRODUCTS.filter(
product=>
product.name
.toLowerCase()
.includes(query)
);

if(!results.length){

searchResults.innerHTML=
'<div class="notice">No products found.</div>';

return;

}

searchResults.innerHTML=
results.map(
product=>`

<div
class="search-result"
data-name="${product.name}"
>

<strong>${product.name}</strong>
—
$${product.price.toFixed(2)}

</div>

`
).join("");

}
);

searchResults.addEventListener(
"click",
function(event){

const item=
event.target.closest(
".search-result"
);

if(!item)return;

const product=
PRODUCTS.find(
p=>p.name===item.dataset.name
);

if(product){

addToList(product,1);

searchInput.value="";

searchResults.innerHTML="";

openPanel("listPanel");

}

}
);

/* MENU LINKS */

document.querySelectorAll(
"a.menu-link"
).forEach(link=>{

link.onclick=function(){

closeAllPanels();

};

});

/* RESTORE */

selectedProducts=
getStorage(
STORAGE.selected,
[]
);

const savedShipping=
getStorage(
STORAGE.shipping,
null
);

if(savedShipping){

const option=
document.querySelector(
`input[name="shipping"][value="${savedShipping}"]`
);

if(option){
option.checked=true;
}

}

const savedPayment=
getStorage(
STORAGE.payment,
null
);

if(savedPayment){

const option=
document.querySelector(
`input[name="payment"][value="${savedPayment}"]`
);

if(option){
option.checked=true;
}

}

renderSelectedProducts();

renderCart();

updateCartCount();

</script>

</body>
</html>
